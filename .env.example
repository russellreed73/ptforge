# Copy this file to .env.local (never commit .env.local).

# Local Postgres from docker-compose.yml
DATABASE_URL=postgres://ptforge:ptforge@localhost:5432/ptforge

# Generate with: pnpm dlx auth@latest secret   (or any 32+ random characters)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Email. Locally, emails go to Mailpit (started by `pnpm db:up`):
# read them at http://localhost:8025
SMTP_URL=smtp://localhost:1025
EMAIL_FROM="PTForge <no-reply@mail.ptforge.app>"
# Production only (set in Vercel, not here): sends real email through Resend.
# RESEND_API_KEY=

# Set to true only when working offline. In production this must be unset so
# new passwords are checked against known data breaches.
DISABLE_PWNED_CHECK=false

# --- Later phases (leave blank for now) ---
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_STREAM_API_TOKEN=
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
