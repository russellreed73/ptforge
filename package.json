{
  "name": "ptforge",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "email:preview": "email dev --dir src/emails --port 3001",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx --env-file-if-exists=.env.local scripts/seed.ts",
    "db:reset": "tsx --env-file-if-exists=.env.local scripts/reset-db.ts && pnpm db:migrate && pnpm db:seed",
    "db:studio": "drizzle-kit studio",
    "neon:env": "neon env pull --file .env.neon",
    "neon:migrate": "tsx scripts/neon-migrate.ts",
    "neon:check": "tsx scripts/neon-check.ts",
    "auth:generate": "pnpm dlx auth@latest generate --config src/server/auth/index.ts --output src/server/db/schema/auth.ts"
  },
  "dependencies": {
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/bebas-neue": "^5.3.0",
    "@react-email/render": "^2.2.0",
    "@vercel/functions": "^3.10.6",
    "better-auth": "^1.7.15",
    "drizzle-orm": "^0.45.4",
    "next": "16.4.4",
    "nodemailer": "^10.3.1",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-email": "^6.11.6",
    "resend": "^6.37.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@react-email/ui": "6.11.6",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.9",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.4",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  }
}
